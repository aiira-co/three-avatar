{
  "name": "@interverse/three-avatar",
  "version": "0.1.0",
  "description": "Portable Three.js avatar runtime and asset format for modular humanoids",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./gltf": {
      "types": "./dist/assets/GltfAvatarAssetLoader.d.ts",
      "import": "./dist/assets/GltfAvatarAssetLoader.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "docs/AUTHORING.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepublishOnly": "pnpm clean && pnpm test"
  },
  "keywords": [
    "three",
    "threejs",
    "avatar",
    "character-customization",
    "mixamo",
    "skinned-mesh",
    "wearables",
    "lip-sync"
  ],
  "author": "Interverse Engine",
  "license": "MIT",
  "peerDependencies": {
    "three": ">=0.185.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "rimraf": "^6.1.3",
    "three": "^0.185.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiira-co/three-avatar.git"
  }
}
